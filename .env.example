NODE_ENV=production
PORT=3000

# Обязательно смените: длинная случайная строка, минимум 32 символа
SESSION_SECRET=change_me_to_long_random_string_at_least_32_chars

DB_PATH=/app/data/newday.db
APP_URL=http://localhost:3000

# Ставьте 0, если приложение НЕ за обратным прокси
TRUST_PROXY=1

# Почта. Без SMTP_HOST подтверждение адреса автоматически отключается,
# и приложение работает без почтового сервера.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
