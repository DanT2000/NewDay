# Copy this file to .env and fill in the values
# cp .env.example .env

# Application
NODE_ENV=production
PORT=3000

# Path to the SQLite database file
# In Docker this is mapped to a named volume at /app/data/planner.db
DB_PATH=./data/planner.db

# Session secret — change to a long random string!
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_a_very_long_random_string_at_least_32_chars
