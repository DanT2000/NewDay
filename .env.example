NODE_ENV=production
PORT=3000

# Обязательно смените: длинная случайная строка, минимум 32 символа
SESSION_SECRET=change_me_to_long_random_string_at_least_32_chars

DB_PATH=/app/data/newday.db
APP_URL=http://localhost:3000

# Ставьте 0, если приложение НЕ за обратным прокси
TRUST_PROXY=1

# Почта. Без SMTP_HOST подтверждение адреса автоматически отключается,
# и приложение работает без почтового сервера.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Уведомления Web Push. Без ключей push просто выключен.
# Сгенерировать: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Раздача Android-приложения с этого сайта.
# APK хранится рядом с базой (в том же постоянном томе) и отдаётся по
# /api/v1/app/download; приложение проверяет /api/v1/app/version при запуске.
# APK_UPLOAD_TOKEN нужен, чтобы CI мог выложить новую сборку. Пока он пуст,
# выкладка закрыта: иначе подменить приложение смог бы любой.
APK_UPLOAD_TOKEN=
# APK_DIR=/app/data/apk
# UPDATE_DISABLED=1                 # выключить проверку обновлений совсем
# UPDATE_APK_URL=                   # если APK раздаётся откуда-то ещё
# UPDATE_VERSION_NAME=
# UPDATE_REPO=owner/repo            # запасной вариант: релизы GitHub
