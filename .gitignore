node_modules/
data/*.db
data/*.db-wal
data/*.db-shm
data/backups/
public/downloads/*.apk
.env
*.log
.DS_Store

# Android: исходники коммитим, сборочный мусор — нет
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties

# Ключи подписи — где бы их ни создали. README предлагает запускать keytool
# в корне проекта, и один случайный `git add -A` опубликовал бы ключ,
# после чего им уже нельзя пользоваться.
*.keystore
*.jks
# Пути и пароли к ключу подписи: в репозитории им места нет
android/keystore.properties
*.p12
*.pem
tools/.shots/

# Инструмент проверки AAB: 31 МБ, качается одной командой при надобности
tools/bundletool.jar
# Готовые артефакты релиза
dist/

# Временные каталоги проверок: профили браузера, базы стендов.
# Лежат рядом с проектом, а не в системном %TEMP% на диске C — см. tools/lib/tmp.js
.tmp/

# Сборки в наборе для магазинов — артефакты, пересобираются командой из PUBLISHING.md
store/*/*.aab
store/*/*.apk
