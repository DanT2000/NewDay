<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            fontScale и density в configChanges: размер шрифта и размер экрана
            человек меняет системным ползунком, и без них экран пересоздаётся —
            начатое пропадает.
        -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|fontScale|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Экран отключения будильника.
            showWhenLocked и turnScreenOn поднимают его поверх локскрина,
            excludeFromRecents не даёт смахнуть его из «недавних»,
            singleInstance — открыть вторую копию поверх первой.
            configChanges обязателен: без него автопереключение тёмной темы
            «по рассвету» — ровно утреннее время — пересоздаёт экран, и
            человек, прошедший 28 шагов из 30, начинает считать с нуля.
            По той же причине там fontScale и density: размер шрифта и размер
            экрана меняются системным ползунком, и сделать это можно ровно в
            момент звонка — спросонья по ошибке или чтобы разглядеть пример.
            Проверено на эмуляторе: без них `settings put system font_scale
            1.3` пересоздавал экран, и решённая задача «2 из 3» возвращалась
            к «1 из 3».

            directBootAware: до первой разблокировки система не пускает
            обычные активности. Экран отключения умеет работать в этом
            состоянии — всё, что ему нужно, лежит в device-protected
            хранилище, — а без отметки он бы просто не поднялся, и телефон,
            перезагрузившийся ночью, утром молчал бы.
        -->
        <activity
            android:name=".alarm.AlarmActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:directBootAware="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|fontScale|density"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:taskAffinity="ru.appswire.newday.alarm"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!--
            Привязка кода в настройках. Обычный экран приложения, не поверх
            локскрина: сюда приходят днём и осознанно.
        -->
        <activity
            android:name=".alarm.BindCodeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!--
            Держит звук и экран, пока будильник звонит.

            directBootAware: звонок до первой разблокировки идёт через эту
            службу, а неотмеченную службу система в этом состоянии не запустит.
            Credential-хранилища она не касается: список и настройки читает из
            device-protected, звук берёт из ассетов APK.
        -->
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm" />
        </service>

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="ru.appswire.newday.FIRE" />
            </intent-filter>
        </receiver>

        <!-- После перезагрузки система забывает будильники — ставим заново -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!--
                    LOCKED_BOOT_COMPLETED — тот же смысл, но раньше и без пина.

                    На телефонах с шифрованием файлов (почти всё, начиная с
                    Android 10) BOOT_COMPLETED приходит только после первой
                    разблокировки. Телефон, перезагрузившийся сам в три ночи —
                    обновление системы, паника ядра, — до утра никто не
                    отпирает: BOOT_COMPLETED не приходит, будильник никто не
                    ставит заново, и в семь утра его нет вообще. Проверено на
                    эмуляторе с пином: без этой строки после перезагрузки не
                    звонило ничего, с ней — звонит поверх локскрина.
                -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!--
                    Смена пояса и перевод часов: будильники стоят по абсолютному
                    времени, и «подъём в 07:00» после перелёта звонит по прежнему
                    поясу.

                    У перевода часов действие называется TIME_SET, хотя константа
                    в коде — ACTION_TIME_CHANGED. Действия
                    «android.intent.action.TIME_CHANGED» не существует, и такой
                    фильтр не сработал бы ни разу — молча, без единой ошибки.
                -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

    </application>

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Установки обновлений здесь нет нарочно: REQUEST_INSTALL_PACKAGES и
        FileProvider объявлены только во флейворе rustore
        (src/rustore/AndroidManifest.xml). Google Play запрещает приложениям
        обновлять себя в обход магазина, и сборка для Play этого разрешения
        физически не содержит — проверяющему нечего найти.
    -->

    <!-- Будильник -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <!--
        REQUEST_IGNORE_BATTERY_OPTIMIZATIONS здесь нет нарочно.

        Оно нужно только тому, кто показывает системный диалог «разрешить
        работу в фоне» напрямую. Мы этого не делаем: состояние читается
        (isIgnoringBatteryOptimizations разрешения не требует), а человека
        ведём в системный список настроек — тоже без разрешения. Google Play
        считает это разрешение чувствительным и требует обоснования; объявлять
        то, чем не пользуешься, значит просить проверку на пустом месте.
    -->

    <!--
        «Показывать поверх других приложений».
        Без него Android запрещает поднять экран будильника из фона, когда
        телефон разблокирован: full-screen intent в этом случае показывает
        только всплывающее уведомление. Проверено на эмуляторе — система
        отклоняла запуск с rejectTime в appops.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        Задачи пробуждения «QR-код» и «шаги».

        Оба разрешения спрашиваются не при установке, а в тот момент, когда
        человек включает соответствующую задачу: просить камеру у планировщика
        дня на старте — верный способ получить отказ.

        Камера и шагомер объявлены необязательными (required="false"): без них
        приложение работает целиком, просто эти две задачи не предлагаются, а
        уже выбранная задача становится примером.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />

</manifest>
