<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
            Экран отключения будильника.
            showWhenLocked и turnScreenOn поднимают его поверх локскрина,
            excludeFromRecents не даёт смахнуть его из «недавних»,
            singleInstance — открыть вторую копию поверх первой.
            configChanges обязателен: без него автопереключение тёмной темы
            «по рассвету» — ровно утреннее время — пересоздаёт экран, и
            человек, прошедший 28 шагов из 30, начинает считать с нуля.
        -->
        <activity
            android:name=".alarm.AlarmActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:taskAffinity="ru.appswire.newday.alarm"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!--
            Привязка кода в настройках. Обычный экран приложения, не поверх
            локскрина: сюда приходят днём и осознанно.
        -->
        <activity
            android:name=".alarm.BindCodeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Держит звук и экран, пока будильник звонит -->
        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="alarm" />
        </service>

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="ru.appswire.newday.FIRE" />
            </intent-filter>
        </receiver>

        <!-- После перезагрузки система забывает будильники — ставим заново -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Установки обновлений здесь нет нарочно: REQUEST_INSTALL_PACKAGES и
        FileProvider объявлены только во флейворе rustore
        (src/rustore/AndroidManifest.xml). Google Play запрещает приложениям
        обновлять себя в обход магазина, и сборка для Play этого разрешения
        физически не содержит — проверяющему нечего найти.
    -->

    <!-- Будильник -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <!--
        REQUEST_IGNORE_BATTERY_OPTIMIZATIONS здесь нет нарочно.

        Оно нужно только тому, кто показывает системный диалог «разрешить
        работу в фоне» напрямую. Мы этого не делаем: состояние читается
        (isIgnoringBatteryOptimizations разрешения не требует), а человека
        ведём в системный список настроек — тоже без разрешения. Google Play
        считает это разрешение чувствительным и требует обоснования; объявлять
        то, чем не пользуешься, значит просить проверку на пустом месте.
    -->

    <!--
        «Показывать поверх других приложений».
        Без него Android запрещает поднять экран будильника из фона, когда
        телефон разблокирован: full-screen intent в этом случае показывает
        только всплывающее уведомление. Проверено на эмуляторе — система
        отклоняла запуск с rejectTime в appops.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        Задачи пробуждения «QR-код» и «шаги».

        Оба разрешения спрашиваются не при установке, а в тот момент, когда
        человек включает соответствующую задачу: просить камеру у планировщика
        дня на старте — верный способ получить отказ.

        Камера и шагомер объявлены необязательными (required="false"): без них
        приложение работает целиком, просто эти две задачи не предлагаются, а
        уже выбранная задача становится примером.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />

</manifest>
