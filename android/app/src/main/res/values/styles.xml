<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!--
            Системные полосы под цвет приложения, а не белые.

            Цвет и признак «полоса светлая» лежат в system_bars.xml: у пары
            values/values-night свои значения, поэтому стиль здесь один, а тема
            телефона выбирает нужное сама. Это закрывает промежуток от запуска
            до загрузки вебвью; дальше, если тема в приложении разошлась с
            системной, полосы перекрашивает setSystemBars из AlarmPlugin.
        -->
        <item name="android:statusBarColor">@color/system_bar_background</item>
        <item name="android:navigationBarColor">@color/system_bar_background</item>
        <!--
            Тёмные значки на светлой полосе: статусбар умеет это с API 23,
            полоса жестов — с 27. На версиях старее атрибут просто
            игнорируется, поэтому отдельные values-vNN не нужны — tools лишь
            глушит предупреждение анализатора.
        -->
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/system_bars_light</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/system_bars_light</item>
    </style>

    <!--
        Экран запуска — один, а не два подряд.

        Раньше здесь стоял только `android:background`, и получалось вот что: на
        Android 12 и новее система рисует свой экран запуска сама, из иконки
        приложения, а фон окна показывался следом. Человек видел два логотипа по
        очереди, а до правки иконок — ещё и чужой синий крестик первым.

        Теперь системному экрану заданы и фон, и иконка, а `postSplashScreenTheme`
        говорит, куда уходить после него.

        Цвет и картинки экрана запуска следуют за темой телефона: ресурсы с
        уточнителем -night подхватываются на тёмной теме сами. Имя цвета своё,
        не ic_launcher_background: тот принадлежит иконке запуска, которая
        остаётся светлой всегда, — ночной вариант общего имени затемнил бы и её.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- на Android 11 и старше системного экрана нет: там работает фон окна -->
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
