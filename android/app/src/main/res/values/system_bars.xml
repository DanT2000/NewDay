<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Фон приложения (‑‑bg в public/js/web/data.js). Системные полосы —
        статусбар и полоса жестов — красятся под него прямо из темы, чтобы
        не белеть, пока вебвью ещё не загрузился. Ночной вариант лежит рядом
        в values-night и подхватывается системой сам.

        Если человек выберет в приложении тему не как у телефона, эти цвета
        станут неверными — тогда полосы перекрашивает setSystemBars
        из AlarmPlugin, уже по команде веб-части.
    -->
    <color name="system_bar_background">#f3f5fe</color>
    <!-- Светлый фон — тёмные значки на полосах; иначе их не видно -->
    <bool name="system_bars_light">true</bool>
</resources>
