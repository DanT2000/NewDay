{
  "name": "newday",
  "version": "1.0.0",
  "description": "Personal day planner - NewDay",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "cap:init": "npx cap init NewDay ru.appswire.newday --web-dir public",
